# AWS configuration
AWS_REGION=ap-southeast-2
API_GATEWAY_URL=https://pr8f2gf36a.execute-api.ap-southeast-2.amazonaws.com

# DynamoDB
DYNAMODB_TABLE_WASTE_BINS=WasteBins
DYNAMODB_TABLE_BIN_READINGS=BinReadings

# Storage and notifications
S3_BUCKET_NAME=your-s3-bucket-name
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:YOUR_ACCOUNT_ID:waste-threshold-alerts

# Waste monitoring thresholds
ALERT_THRESHOLD_PERCENT=85.0
RESET_THRESHOLD_PERCENT=50.0
CAPACITY_PREDICTION_TARGET_PERCENT=90.0

# Depot location
DEPOT_NAME=VIT Estates & Maintenance Depot
DEPOT_LATITUDE=12.9685
DEPOT_LONGITUDE=79.1550

# Simulator
SIMULATOR_API_ENDPOINT=https://pr8f2gf36a.execute-api.ap-southeast-2.amazonaws.com/readings
SIMULATOR_INTERVAL_SECONDS=10
SIMULATOR_NUM_BINS=12